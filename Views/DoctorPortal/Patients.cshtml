@model DoctorPatientsViewModel
@{ ViewData["Title"] = "Patients and insights"; }
<section class="portal-hero compact"><div class="container"><div><p class="eyebrow">Doctor workspace</p><h1>Patients &amp; insights</h1><p>Understand your client load and consultation history at a glance.</p></div><div class="insight-period">Updated @DateTime.Now.ToString("d MMM, HH:mm")</div></div></section>
<div class="container"><partial name="_DoctorNav" /></div>
<section class="portal-content"><div class="container"><div class="stat-grid insight-stats"><article><small>Upcoming clients</small><strong>@Model.UpcomingClients</strong><span>Unique patients scheduled</span></article><article><small>Clients consulted</small><strong>@Model.ConsultedClients</strong><span>Unique completed patients</span></article><article><small>Completed consultations</small><strong>@Model.CompletedConsultations</strong><span>@Model.ConsultationsThisMonth this month</span></article><article><small>Completion rate</small><strong>@Model.CompletionRate%</strong><span>@Model.CancelledAppointments cancellations</span></article></div><div class="insight-grid">
<section class="portal-panel"><div class="panel-heading"><div><p class="eyebrow">Next in line</p><h2>Upcoming clients</h2></div><span>@Model.Upcoming.Count bookings shown</span></div>
@if(Model.Upcoming.Count==0){<div class="empty-state"><strong>No upcoming clients</strong><p>New confirmed appointments will appear here.</p></div>}else{<div class="client-table">@foreach(var item in Model.Upcoming){<article><div class="client-avatar">@item.User.FullName[0]</div><div><strong>@item.User.FullName</strong><small>@item.User.Email</small></div><div><strong>@item.Date.ToString("d MMM")</strong><small>@item.Time</small></div><span>@item.Reason</span></article>}</div>}</section>
<section class="portal-panel"><div class="panel-heading"><div><p class="eyebrow">Care history</p><h2>Recent consultations</h2></div><span>@Model.RecentConsultations.Count shown</span></div>
@if(Model.RecentConsultations.Count==0){<div class="empty-state"><strong>No completed consultations yet</strong><p>Appointments marked complete will build your consultation history.</p></div>}else{<div class="client-table">@foreach(var item in Model.RecentConsultations){<article><div class="client-avatar complete">✓</div><div><strong>@item.User.FullName</strong><small>@item.User.Email</small></div><div><strong>@item.Date.ToString("d MMM yyyy")</strong><small>@item.Time</small></div><span>@item.Reason</span></article>}</div>}</section>
</div></div></section>
