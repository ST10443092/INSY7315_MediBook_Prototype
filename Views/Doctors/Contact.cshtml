@model DoctorRecord
@{ViewData["Title"]=$"Contact {Model.Name}";}
<section class="page-hero"><div class="container"><p class="eyebrow">Doctor details</p><h1>Message @Model.Name</h1><p>For emergencies, contact your local emergency service.</p></div></section><section class="form-section"><div class="container narrow"><article class="contact-card"><div class="doctor-top"><div class="avatar">D<span></span></div><div><h2>@Model.Name</h2><p>@Model.Specialty</p></div></div><div class="contact-list"><a href="tel:@Model.Phone"><small>Phone</small><strong>@Model.Phone</strong></a><a href="mailto:@Model.Email"><small>Email</small><strong>@Model.Email</strong></a><div><small>Hours</small><strong>Monday–Friday, 08:00–18:00</strong></div><div><small>Address</small><strong>24 Wellness Avenue, Johannesburg</strong></div></div><a class="button" asp-controller="Booking" asp-action="Index">Book an appointment</a></article></div></section>
