@model IReadOnlyList<DoctorRecord>
@{ ViewData["Title"] = "Healthcare on your schedule"; }
<section id="home" class="hero"><div class="container hero-content"><span class="availability"><i></i>Appointments available today</span><h1>Healthcare on<br/><em>your schedule</em></h1><p>Book appointments with top specialists in minutes — no phone calls, no waiting. Our intelligent platform puts you in control of your health journey.</p><div class="hero-actions"><a class="button button-light" asp-controller="Booking" asp-action="Index">Book an appointment</a><a class="button button-outline" href="#doctors">Browse doctors</a></div></div></section>
<section class="section"><div class="container"><p class="eyebrow">How it works</p><h2>Four steps to your appointment</h2><div class="steps"><article><span>01</span><h3>Create your account</h3><p>Register in under two minutes. Your medical information stays private and secure.</p></article><article><span>02</span><h3>Choose a doctor</h3><p>Browse specialists and choose the right fit for your care.</p></article><article><span>03</span><h3>Pick your slot</h3><p>Select a date and time that works for you.</p></article><article><span>04</span><h3>Get confirmed</h3><p>Your appointment is saved instantly to your account.</p></article></div></div></section>
<section id="doctors" class="section doctors-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Find your care</p><h2>Meet our doctors</h2><p class="muted">Choose from @Model.Count specialists and book a time that works for you.</p></div></div><div class="doctor-grid">
@foreach (var doctor in Model)
{
    <article class="doctor-card"><div class="doctor-top"><div class="avatar">@doctor.Name.Replace("Dr. ", "")[0]@if(doctor.IsAvailable){<span></span>}</div><div><h3>@doctor.Name</h3><p>@doctor.Specialty</p></div></div><div class="doctor-details"><div><small>Availability</small><strong>@(doctor.IsAvailable ? $"Open · {doctor.AvailableFrom}–{doctor.AvailableTo}" : "Bookings paused")</strong></div><div class="card-actions"><a class="outline-button" asp-controller="Doctors" asp-action="Contact" asp-route-id="@doctor.Id">Message</a>@if(doctor.IsAvailable){<a class="button" asp-controller="Booking" asp-action="Index" asp-route-doctorId="@doctor.Id">Book</a>}else{<span class="button disabled">Unavailable</span>}</div></div></article>
}
</div></div></section>
<section id="appointments" class="section appointments"><div class="container"><p class="eyebrow">Your care</p><h2>My appointments</h2><div class="appointment-card"><div><h3>View your saved appointments</h3><p>Your upcoming appointments with every MediBook doctor are kept together.</p></div><a class="outline-button" asp-controller="Booking" asp-action="Index">View appointments</a></div></div></section>
<section class="account-section"><div class="container account-cta"><div><p class="eyebrow">Ready when you are</p><h2>Take charge of your healthcare.</h2><p>Create an account to book and manage appointments.</p></div><a class="button button-light" asp-controller="Booking" asp-action="Index">Get started</a></div></section>
