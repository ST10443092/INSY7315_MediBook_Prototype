<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] - MediBook</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/forms.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/database.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/doctor-portal.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/doctor-insights.css" asp-append-version="true"/></head><body>
<header class="site-header"><nav class="nav container" aria-label="Main navigation"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">+</span><span>MediBook</span></a><div class="nav-links"><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Home" asp-action="Index" asp-fragment="doctors">Find a Doctor</a><a asp-controller="Booking" asp-action="Index">Appointments</a><a asp-controller="DoctorPortal" asp-action="Dashboard">Doctor portal</a><a asp-controller="Doctors" asp-action="Add">Add doctor</a></div><div class="nav-actions"><a class="sign-in" asp-controller="Account" asp-action="Index" asp-route-mode="login">Sign in demo</a><a class="button button-small" asp-controller="Booking" asp-action="Index">Book now</a></div></nav></header><main>@RenderBody()</main>
<footer class="site-footer"><div class="container footer-grid"><div><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">+</span><span>MediBook</span></a><p>Healthcare appointments, simplified.</p></div><div><h4>Platform</h4><a asp-controller="Home" asp-action="Index" asp-fragment="doctors">Find a doctor</a><a asp-controller="Booking" asp-action="Index">Book appointment</a></div><div><h4>Support</h4><a asp-controller="Home" asp-action="Privacy">Privacy policy</a></div><div><h4>Contact</h4><a href="mailto:support@medibook.health">support@medibook.health</a><span>Mon–Fri 8am–6pm</span></div></div><div class="container footer-bottom"><span>© 2026 MediBook Health Ltd.</span><span>Private and secure healthcare booking</span></div></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
